<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityJsonPath Condition="'$(UnityJsonPath)' == ''">../Library/PackageCache/com.unity.nuget.newtonsoft-json@3.2.1/Runtime/Newtonsoft.Json.dll</UnityJsonPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/GameEngine/**/*.cs" />
    <Reference Include="Newtonsoft.Json" Condition="Exists('$(UnityJsonPath)')"><HintPath>$(UnityJsonPath)</HintPath></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" Condition="!Exists('$(UnityJsonPath)')" />
    <Content Include="../Assets/StreamingAssets/GameData/**/*" Exclude="../Assets/StreamingAssets/GameData/**/*.meta">
      <Link>Data/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
